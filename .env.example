# Supabase project (Project Settings > API in the Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. NEVER prefix with NEXT_PUBLIC_, never expose to the client.
# Required from Phase 6 onward: the WhatsApp/email inbound webhook routes
# (app/api/webhooks/*) have no Supabase user session at all - Meta/Resend
# call them directly - so they use the service-role client
# (lib/supabase/admin.ts) instead of the normal per-request one. Every
# other route still uses the authenticated server client; this key is
# never used outside those two webhook routes and admin.ts itself.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Required from Phase 2 onward for AI-assisted lead
# discovery, research, scoring, website audits, opportunity analysis,
# sales strategy generation, and outreach draft generation (Find Leads,
# Research, Score, Audit Website, Generate Outreach). Get a key from
# https://console.anthropic.com/ (API Keys). Without this set, those
# features return a clear "AI is not configured" error rather than
# failing silently - the rest of the app works fine without it.
ANTHROPIC_API_KEY=

# Optional. Overrides the default model (claude-opus-5) used for all AI
# calls. Leave unset unless you deliberately want a different model/cost
# tradeoff - see README.md.
ANTHROPIC_MODEL=

# Server-only. Required from Phase 5 onward to actually send WhatsApp
# messages (the official WhatsApp Business Platform / Meta Cloud API -
# never WhatsApp Web automation). Without these set, Send shows a clear
# "WhatsApp sending is not configured" error rather than failing
# silently or faking a send - see README.md for full setup, including
# the one-time step of creating and getting Meta approval for a message
# template (business-initiated WhatsApp messages cannot be free-form
# text).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=

# Optional. Overrides the Meta Graph API version used for WhatsApp sends
# (default: see DEFAULT_WHATSAPP_API_VERSION in
# lib/outreach/whatsapp-provider.ts). Leave unset unless Meta has moved
# the default version past what's hard-coded there.
WHATSAPP_API_VERSION=

# Server-only. Required from Phase 5 onward to actually send email
# (via Resend). Without these set, Send shows a clear "Email sending is
# not configured" error rather than failing silently or faking a send.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional. Display name shown alongside RESEND_FROM_EMAIL in the "From"
# header (e.g. "Zviko Labs").
RESEND_FROM_NAME=

# Server-only. Required from Phase 6 onward to receive and verify
# inbound WhatsApp webhook deliveries (see README.md "Response tracking
# setup"). WHATSAPP_APP_SECRET is the Meta app's App Secret (Meta App
# Dashboard > App Settings > Basic) - NOT the access token - used to
# verify the X-Hub-Signature-256 header on every delivery.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN is an arbitrary string you choose
# yourself and enter in both places (here and in the Meta dashboard's
# webhook configuration) for the one-time subscription handshake.
# Without these set, the webhook route returns a clear "not configured"
# error rather than accepting unverified deliveries.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Server-only. Required from Phase 6 onward to receive and verify
# inbound email webhook deliveries from Resend. This is the `whsec_...`
# signing secret Resend generates when you create the webhook
# subscription (Resend Dashboard > Webhooks) - distinct from
# RESEND_API_KEY.
RESEND_WEBHOOK_SECRET=
